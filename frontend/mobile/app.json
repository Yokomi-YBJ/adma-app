{
  "expo": {
    "name": "Adma",
    "slug": "adma",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "backgroundColor": "#FAFBFC",
    "notification": {
      "icon": "./assets/notification-icon.png",
      "color": "#5FC2BA",
      "androidMode": "default"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "cm.adma.app",
      "buildNumber": "1",
      "infoPlist": {
        "NSPhotoLibraryUsageDescription": "Adma accède à vos photos pour votre fiche prestataire.",
        "NSLocationWhenInUseUsageDescription": "Adma utilise votre localisation pour définir votre zone de service et trouver des prestataires autour de vous."
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#FFFFFF"
      },
      "package": "cm.adma.app",
      "googleServicesFile": "./google-services.json",
      "versionCode": 1,
      "permissions": [
        "INTERNET",
        "VIBRATE",
        "ACCESS_FINE_LOCATION",
        "ACCESS_COARSE_LOCATION"
      ],
      "blockedPermissions": [
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.RECEIVE_BOOT_COMPLETED"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.ico",
      "bundler": "metro"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#FAFBFC",
          "image": "./assets/icon.png",
          "imageWidth": 150,
          "resizeMode": "contain"
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "enableMinifyInReleaseBuilds": true,
            "enableShrinkResourcesInReleaseBuilds": true,
            "enableProguardInReleaseBuilds": true,
            "useLegacyPackaging": false
          }
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/notification-icon.png",
          "color": "#5FC2BA"
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Adma accède à vos photos pour votre fiche prestataire.",
          "cameraPermission": false,
          "microphonePermission": false
        }
      ],
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": false,
          "locationWhenInUsePermission": "Adma utilise votre localisation pour définir votre zone de service et trouver des prestataires autour de vous."
        }
      ],
      "@maplibre/maplibre-react-native",
      "expo-web-browser"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "scheme": "adma",
    "extra": {
      "eas": {
        "projectId": "160b6466-2957-49fc-99dc-2314ea79fe59"
      },
      "router": {
        "origin": false
      }
    }
  }
}
