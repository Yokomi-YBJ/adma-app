{
  "cli": {
    "version": ">= 16.26.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "env": {
        "GOOGLE_SERVICES_B64": "@secrets:GOOGLE_SERVICES_B64"
      },
      "hooks": {
        "preBuild": "echo $GOOGLE_SERVICES_B64 | base64 -d > google-services.json"
      }
    },
    "preview": {
      "distribution": "internal",
      "env": {
        "GOOGLE_SERVICES_B64": "@secrets:GOOGLE_SERVICES_B64"
      },
      "hooks": {
        "preBuild": "echo $GOOGLE_SERVICES_B64 | base64 -d > google-services.json"
      }
    },
    "production": {
      "autoIncrement": true,
      "env": {
        "GOOGLE_SERVICES_B64": "@secrets:GOOGLE_SERVICES_B64"
      },
      "hooks": {
        "preBuild": "echo $GOOGLE_SERVICES_B64 | base64 -d > google-services.json"
      }
    }
  },
  "submit": {
    "production": {}
  }
}