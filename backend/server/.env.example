# ================================================================
# ADMA — Variables d'environnement Backend
# Copier en .env et renseigner toutes les valeurs
# NE JAMAIS COMMITTER .env
# ================================================================

# ── Serveur ──────────────────────────────────────────────────────
NODE_ENV=development
PORT=5000
API_URL=http://localhost:5000
CLIENT_URL=http://localhost:3000

# ── Base de données ───────────────────────────────────────────────
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=adma_db
DB_SSL=false

# ── JWT ───────────────────────────────────────────────────────────
JWT_SECRET=changez_moi_minimum_64_caracteres_aleatoires
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES=30d
ADMIN_JWT_SECRET=changez_moi_admin_minimum_64_caracteres
ADMIN_JWT_EXPIRES=8h

# ── Orange Developer Cameroun (SMS OTP) ──────────────────────────
# Inscription : https://developer.orange.com
# 1. Créer une application → récupérer Client ID + Client Secret
# 2. Souscrire à "SMS Cameroon (2.0)" sur le portail
# 3. Acheter un bundle SMS avec votre SIM Orange (Airtime ou Orange Money)
# 4. Renseigner ici votre Client ID et Client Secret
ORANGE_CLIENT_ID=votre_client_id_orange
ORANGE_CLIENT_SECRET=votre_client_secret_orange
# Votre numéro Orange enregistré comme expéditeur (format +237XXXXXXXXX)
ORANGE_SENDER_NUMBER=+237690000000

# ── Cloudinary (Stockage images) ─────────────────────────────────
CLOUDINARY_CLOUD_NAME=votre_cloud_name
CLOUDINARY_API_KEY=000000000000000
CLOUDINARY_API_SECRET=xxxxxxxxxxxxxxxxxxxxxxxx

# ── KPay (Paiements Mobile Money) ────────────────────────────────
KPAY_API_KEY=kpay_live_xxxxxxxxxxxxxxxx
KPAY_SECRET_KEY=xxxxxxxxxxxxxxxxxxxxxxxx
KPAY_BASE_URL=https://admin.kpay.site/api/v1
KPAY_WEBHOOK_SECRET=xxxxxxxxxxxxxxxxxxxxxxxx

# ── Resend (Email OTP Admin) ─────────────────────────────────────
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxx
RESEND_FROM_EMAIL=noreply@adma.cm

# ── Expo (Notifications Push) ────────────────────────────────────
EXPO_ACCESS_TOKEN=xxxxxxxxxxxxxxxxxxxxxxxx

# ── Sécurité ──────────────────────────────────────────────────────
BCRYPT_ROUNDS=12
OTP_EXPIRES_MINUTES=10
OTP_MAX_ATTEMPTS=3
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8081
