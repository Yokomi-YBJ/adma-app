# ================================================================
# ADMA — Variables d'environnement Backend
# Copier en .env et renseigner toutes les valeurs
# NE JAMAIS COMMITTER .env
# ================================================================

# ── Serveur ──────────────────────────────────────────────────────
NODE_ENV=development
PORT=5000
API_URL=http://localhost:5000
CLIENT_URL=http://localhost:3000

# ── Base de données (MySQL local ou TiDB Cloud) ───────────────────
# Pour TiDB Cloud Serverless :
# DB_HOST=gateway01.eu-central-1.prod.aws.tidbcloud.com (ou us-east-1)
# DB_PORT=4000
# DB_USER=xxxxxx.root
# DB_PASSWORD=votre_mot_de_passe_tidb
# DB_NAME=adma_db
# DB_SSL=true
# DB_SSL_REJECT_UNAUTHORIZED=true
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=adma_db
DB_SSL=false
DB_SSL_REJECT_UNAUTHORIZED=true

# ── JWT ───────────────────────────────────────────────────────────
JWT_SECRET=changez_moi_minimum_64_caracteres_aleatoires
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES=30d
ADMIN_JWT_SECRET=changez_moi_admin_minimum_64_caracteres
ADMIN_JWT_EXPIRES=8h

# ── Mboasms (SMS OTP) ────────────────────────────────────────────
# Inscription : https://mboasms.com
# 1. Créer un compte développeur
# 2. Récupérer votre clé API (généralement dans le tableau de bord)
# 3. Renseigner vos identifiants ci-dessous
MBOASMS_API_KEY=votre_cle_api_mboasms
# URL de base de l'API Mboasms (à vérifier dans leur doc)
MBOASMS_API_URL=https://api.mboasms.com/v1
# Identifiant de l'expéditeur (nom ou numéro court)
MBOASMS_SENDER_ID=ADMA
# Optionnel : chemin de l'endpoint pour l'envoi de SMS
MBOASMS_SEND_ENDPOINT=/sms/send

# ── Cloudinary (Stockage images) ─────────────────────────────────
CLOUDINARY_CLOUD_NAME=votre_cloud_name
CLOUDINARY_API_KEY=000000000000000
CLOUDINARY_API_SECRET=xxxxxxxxxxxxxxxxxxxxxxxx

# ── GeniusPay (Paiements Mobile Money) ────────────────────────────────
GENIUSPAY_BASE_URL=https://geniuspay.ci/api/v1/merchant
GENIUSPAY_API_KEY=pk_live_xxxxxxxxxxxx
GENIUSPAY_SECRET_KEY=sk_live_xxxxxxxxxxxx
GENIUSPAY_WEBHOOK_SECRET=whsec_xxxxxxxxxxxx

# ── Resend (Email OTP Admin) ─────────────────────────────────────
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxx
RESEND_FROM_EMAIL=noreply@adma.cm

# ── Expo (Notifications Push) ────────────────────────────────────
EXPO_ACCESS_TOKEN=xxxxxxxxxxxxxxxxxxxxxxxx

# ── Sécurité ──────────────────────────────────────────────────────
BCRYPT_ROUNDS=12
OTP_EXPIRES_MINUTES=10
OTP_MAX_ATTEMPTS=3
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8081
ADMIN_ALERT_EMAIL = beyeayokomi@gmail.com