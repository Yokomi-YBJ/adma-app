{
  "name": "adma-server",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Adma API — Node.js 22 + Express 5",
  "main": "src/server.js",
  "engines": { "node": ">=20.0.0" },
  "scripts": {
    "dev":       "nodemon --watch src --ext js src/server.js",
    "start":     "node src/server.js",
    "db:import": "node src/database/runMigrations.js"
  },
  "dependencies": {
    "bcryptjs":           "^2.4.3",
    "cloudinary":         "^2.2.0",
    "compression":        "^1.7.4",
    "cors":               "^2.8.5",
    "dotenv":             "^16.4.5",
    "expo-server-sdk":    "^3.10.0",
    "express":            "^4.21.0",
    "express-rate-limit": "^7.4.0",
    "express-validator":  "^7.2.0",
    "helmet":             "^7.1.0",
    "jsonwebtoken":       "^9.0.2",
    "morgan":             "^1.10.0",
    "multer":             "^1.4.5-lts.1",
    "mysql2":             "^3.11.0",
    "node-cron":          "^3.0.3",
    "resend":             "^4.0.0",
    "twilio":             "^5.3.0",
    "uuid":               "^10.0.0",
    "winston":            "^3.14.0"
  },
  "devDependencies": {
    "nodemon": "^3.1.7"
  }
}
